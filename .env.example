APP_NAME=AI Voice Appointment System
APP_ENV=development
DATABASE_URL=sqlite:///./appointments.db
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
CURRENCY=LKR
BUSINESS_TIMEZONE=Asia/Colombo
ACTIVE_TRANSACTION_TTL_MINUTES=30
PENDING_CONFIRMATION_TTL_MINUTES=10
AVAILABILITY_OPTIONS_TTL_MINUTES=10
IDEMPOTENCY_EXECUTION_TTL_MINUTES=5

AI_PROVIDER=gemini

GOOGLE_API_KEY=replace_with_your_google_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini

